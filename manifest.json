{
  "manifest_version": 2,
  "name": "TikTok Sidebar",
  "version": "0.2.0",
  "description": "Watch TikTok in the Firefox sidebar.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tiktok-sidebar@tiktik.local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "*://*.tiktok.com/*",
    "*://*.tiktokcdn.com/*",
    "*://*.tiktokv.com/*",
    "*://apps.apple.com/*",
    "*://itunes.apple.com/*",
    "*://play.google.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Toggle TikTok sidebar",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "sidebar_action": {
    "default_title": "TikTok",
    "default_panel": "sidebar.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    },
    "open_at_install": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*"
      ],
      "js": [
        "hide-app-banner.js",
        "autoscroll.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}